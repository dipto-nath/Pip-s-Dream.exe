# =============================================================
# Pip's Dream.exe — Environment Variables
# =============================================================
# Copy this file to .env.local (frontend) and configure as needed.
# The backend runs on http://localhost:3001 during local development.
# For production, set VITE_API_BASE_URL to your Supabase functions URL.
#
# Example production value:
# VITE_API_BASE_URL=https://your-project-ref.supabase.co/functions/v1
# =============================================================

# Frontend: Backend API base URL
# Leave empty to use /api (proxied by Vite dev server to localhost:3001)
VITE_API_BASE_URL=
