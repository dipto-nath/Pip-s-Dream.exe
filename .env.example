# =============================================================
# Pip's Dream.exe — Root Environment Variables
# =============================================================
# Copy to frontend/.env.local and configure as needed.
# Backend runs on http://localhost:3001 during local development.
# Frontend dev server runs on http://localhost:5173.
# =============================================================

# ── Frontend ──────────────────────────────────────────────
# API base URL — leave empty to use relative /api (proxied by
# Vite dev server to localhost:3001). In production, set this
# to your Supabase functions URL:
#   VITE_API_BASE_URL=https://<ref>.supabase.co/functions/v1
VITE_API_BASE_URL=

# ── Backend (optional, local dev) ─────────────────────────
# The local backend uses JSON file storage (data/data.json).
# No env vars are required for local development.
# For Supabase Edge Functions, configure secrets in the
# Supabase dashboard instead.
